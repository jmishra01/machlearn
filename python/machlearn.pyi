class SimpleImputer:
    @staticmethod
    def mean() -> SimpleImputer: ...
    @staticmethod
    def median() -> SimpleImputer: ...
    @staticmethod
    def constant(value: float) -> SimpleImputer: ...
    def fit(self, records: NDArray[np.float64]) -> None: ...
    def transform(self, records: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def fit_transform(self, records: NDArray[np.float64]) -> NDArray[np.float64]: ...
    @property
    def fill_values(self) -> NDArray[np.float64]: ...

class PolynomialFeatures:
    def __init__(
