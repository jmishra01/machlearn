import numpy as np
from numpy.typing import NDArray

class Dataset:
    def __init__(self, records: NDArray[np.float64], targets: NDArray[np.float64]) -> None: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def records(self) -> NDArray[np.float64]: ...
    @property
    def targets(self) -> NDArray[np.float64]: ...

class LinearRegression:
    def __init__(self, fit_intercept: bool = True) -> None: ...
    def fit(self, dataset: Dataset) -> None: ...
    def predict(self, records: NDArray[np.float64]) -> NDArray[np.float64]: ...
    @property
    def coefficients(self) -> NDArray[np.float64]: ...
    @property
    def intercept(self) -> float: ...

class LogisticRegression:
    def __init__(self, fit_intercept: bool = True) -> None: ...
    def fit(self, records: NDArray[np.float64], targets: NDArray[np.int64]) -> None: ...
    def predict(self, records: NDArray[np.float64]) -> NDArray[np.int64]: ...
    def predict_proba(self, records: NDArray[np.float64]) -> NDArray[np.float64]: ...
    @property
    def classes(self) -> tuple[int, int]: ...
    @property
    def coefficients(self) -> NDArray[np.float64]: ...
    @property
    def intercept(self) -> float: ...

