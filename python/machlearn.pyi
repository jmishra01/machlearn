        interaction_only: bool = False,
    ) -> None: ...
    def fit(self, records: NDArray[np.float64]) -> None: ...
    def transform(self, records: NDArray[np.float64]) -> NDArray[np.float64]: ...
    def fit_transform(self, records: NDArray[np.float64]) -> NDArray[np.float64]: ...

class LabelEncoder:
    def __init__(self) -> None: ...
    def fit(self, labels: list[str]) -> None: ...
    def transform(self, labels: list[str]) -> NDArray[np.int64]: ...
    def inverse_transform(self, codes: list[int]) -> list[str]: ...
    @property
    def classes(self) -> list[str]: ...

class OneHotEncoder:
    def __init__(self, drop_first: bool = False) -> None: ...
    def fit(self, labels: list[str]) -> None: ...
    def transform(self, labels: list[str]) -> NDArray[np.float64]: ...
    @property
    def classes(self) -> list[str]: ...

def train_test_split(
    dataset: Dataset,
    test_fraction: float,
    seed: int = 42,
    shuffle: bool = True,
) -> tuple[Dataset, Dataset]: ...

class KFold:
    def __init__(self, n_splits: int, shuffle: bool = False, seed: int = 42) -> None: ...
    def split(
        self, n_samples: int
    ) -> list[tuple[NDArray[np.int64], NDArray[np.int64]]]: ...

class StratifiedKFold:
    def __init__(self, n_splits: int, shuffle: bool = False, seed: int = 42) -> None: ...
    def split(
        self, targets: list[int]
    ) -> list[tuple[NDArray[np.int64], NDArray[np.int64]]]: ...

def accuracy_score(actual: NDArray[np.int64], predicted: NDArray[np.int64]) -> float: ...
def mean_squared_error(actual: NDArray[np.float64], predicted: NDArray[np.float64]) -> float: ...
def r2_score(actual: NDArray[np.float64], predicted: NDArray[np.float64]) -> float: ...
def precision_score(actual: NDArray[np.int64], predicted: NDArray[np.int64]) -> float: ...
def recall_score(actual: NDArray[np.int64], predicted: NDArray[np.int64]) -> float: ...
def f1_score(actual: NDArray[np.int64], predicted: NDArray[np.int64]) -> float: ...
def roc_auc_score(
    actual: NDArray[np.int64],
    positive_probabilities: NDArray[np.float64],
    positive_label: int,
) -> float: ...
def confusion_matrix(
    actual: NDArray[np.int64], predicted: NDArray[np.int64]
) -> tuple[NDArray[np.int64], NDArray[np.int64]]: ...
